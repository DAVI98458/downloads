-- Eliminate all existing damage Button
MiscTab:Button({
    Title = "eliminate all existing damage",
    Callback = function()
        local lights = workspace:FindFirstChild("Lights")
        if not lights then return end
        
        local children = lights:GetChildren()
        local totalToDelete = 0
        
        for i = 1, 10 do
            local child = children[i]
            if child and child:FindFirstChild("Zone") then
                totalToDelete = totalToDelete + 1
            end
        end
        
        if totalToDelete == 0 then
            WindUI:Notify({
                Title = "Info",
                Content = "no zones found",
                Duration = 3,
            })
            return
        end
        
        WindUI:Notify({
            Title = "Deleting",
            Content = "deleting...",
            Duration = 2,
        })
        
        task.spawn(function()
            for i = 1, 10 do
                local child = children[i]
                if child and child:FindFirstChild("Zone") then
                    child.Zone:Destroy()
                    task.wait(1)
                end
            end
            
            WindUI:Notify({
                Title = "Done",
                Content = "all deleted",
                Duration = 3,
            })
        end)
    end,
})

-- Esp Monsters at the window Toggle
local espMonstersConnection
local espHighlights = {}

local function applyESP()
    local windows = workspace:FindFirstChild("Windows")
    if not windows then return end
    
    local children = windows:GetChildren()
    for i = 1, 80 do
        local child = children[i]
        if child then
            local monster = child:FindFirstChild("Monster")
            if monster and not monster:FindFirstChildOfClass("Highlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "MonsterESP"
                hl.FillColor = Color3.new(1, 0, 0)
                hl.FillTransparency = 1
                hl.OutlineColor = Color3.new(1, 0, 0)
                hl.OutlineTransparency = 0.3
                hl.Adornee = monster
                hl.Parent = monster
                table.insert(espHighlights, hl)
            end
        end
    end
end

MiscTab:Toggle({
    Title = "Esp Monsters at the window",
    Value = false,
    Callback = function(state)
        if state then
            applyESP()
            espMonstersConnection = game:GetService("RunService").Heartbeat:Connect(function()
                applyESP()
            end)
        else
            if espMonstersConnection then
                espMonstersConnection:Disconnect()
                espMonstersConnection = nil
            end
            for _, hl in ipairs(espHighlights) do
                if hl then
                    hl:Destroy()
                end
            end
            table.clear(espHighlights)
        end
    end,
})

